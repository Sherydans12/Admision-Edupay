# Credenciales exclusivamente sintéticas para PostgreSQL local/de desarrollo.
# Copiar este archivo a .env. Nunca usar estos valores fuera del entorno local.
POSTGRES_BOOTSTRAP_USER=admission_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=admission_bootstrap_local_only
POSTGRES_DB=admission_dev
DATABASE_MIGRATION_URL=postgresql://admission_migrator:admission_migrator_local_only@localhost:55439/admission_dev
DATABASE_APP_URL=postgresql://admission_app:admission_app_local_only@localhost:55439/admission_dev
