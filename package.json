{
  "name": "admission-edupay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "10.19.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @admission/database db:generate",
    "db:migrate": "pnpm --filter @admission/database db:migrate",
    "db:reset": "docker compose down --volumes --remove-orphans && docker compose up -d postgres",
    "e4:deploy:smoke": "node scripts/e4-deploy-smoke.mjs",
    "e4:recovery:smoke": "node scripts/e4-recovery-smoke.mjs",
    "e5c:documents:smoke": "node scripts/e5c-documents-smoke.mjs",
    "e5c:migration:smoke": "node scripts/e5c-migration-smoke.mjs",
    "e5d:migration:smoke": "node scripts/e5d-migration-smoke.mjs",
    "e5e:migration:smoke": "node scripts/e5e-migration-smoke.mjs",
    "e5f:migration:smoke": "node scripts/e5f-migration-smoke.mjs",
    "e5g:migration:smoke": "node scripts/e5g-migration-smoke.mjs",
    "e5h:migration:smoke": "node scripts/e5h-migration-smoke.mjs",
    "e5i:migration:smoke": "node scripts/e5i-migration-smoke.mjs",
    "g5br:migration:smoke": "node scripts/g5br-migration-smoke.mjs",
    "g5pc1r12:migration:smoke": "node scripts/g5pc1r12-migration-smoke.mjs",
    "g5pc1r4:migration:smoke": "node scripts/g5pc1r4-migration-smoke.mjs",
    "g5pc1r3:migration:smoke": "node scripts/g5pc1r3-migration-smoke.mjs",
    "g5pc1r5:migration:smoke": "node scripts/g5pc1r5-migration-smoke.mjs",
    "g5p2:migration:smoke": "node scripts/g5p2-migration-smoke.mjs",
    "g5coolify:config:smoke": "node scripts/g5coolify-config-smoke.mjs",
    "g5or:operations:smoke": "tsx --tsconfig apps/api/tsconfig.json scripts/g5or-operations-smoke.ts",
    "g5or:recovery:smoke": "node scripts/g5or-recovery-smoke.mjs",
    "e5i:boundary:check": "node scripts/e5i-boundary-check.mjs",
    "db:up": "docker compose up -d postgres",
    "dev:api": "pnpm --filter @admission/api dev",
    "dev:web": "pnpm --filter @admission/web dev",
    "dev:worker": "pnpm --filter @admission/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "security:secrets": "node scripts/security-scan.mjs",
    "security:deps": "pnpm audit --audit-level=high",
    "tenant:bootstrap": "tsx scripts/bootstrap-tenant-admin.ts",
    "tenant:bootstrap:synthetic-reviewer": "node scripts/bootstrap-synthetic-authority-reviewer.mjs",
    "tenant:bootstrap:synthetic-operator": "node scripts/bootstrap-synthetic-admissions-operator.mjs",
    "tenant:bootstrap:synthetic-director": "node scripts/bootstrap-synthetic-admissions-director.mjs",
    "test": "vitest run --exclude packages/database/src/tenant-rls.integration.spec.ts --exclude packages/database/src/capacity-offer.rls.integration.spec.ts --exclude packages/database/src/communications.rls.integration.spec.ts --exclude packages/database/src/reporting-admin.rls.integration.spec.ts --exclude packages/database/src/functional-handoff.rls.integration.spec.ts --exclude packages/database/src/sensitive-processing.rls.integration.spec.ts --exclude packages/database/src/business-calendar.rls.integration.spec.ts --exclude packages/database/src/activity-policy.rls.integration.spec.ts --exclude packages/database/src/email-delivery.rls.integration.spec.ts",
    "test:rls": "vitest run packages/database/src/tenant-rls.integration.spec.ts && vitest run packages/database/src/capacity-offer.rls.integration.spec.ts && vitest run packages/database/src/communications.rls.integration.spec.ts && vitest run packages/database/src/reporting-admin.rls.integration.spec.ts && vitest run packages/database/src/functional-handoff.rls.integration.spec.ts && vitest run packages/database/src/sensitive-processing.rls.integration.spec.ts && vitest run packages/database/src/business-calendar.rls.integration.spec.ts && vitest run packages/database/src/activity-policy.rls.integration.spec.ts && vitest run packages/database/src/email-delivery.rls.integration.spec.ts",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
