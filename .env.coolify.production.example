# Contract only. Copy variable names into the Coolify production environment;
# never commit real values. Keep synthetic delivery and documents disabled until
# the corresponding provider, privacy and operational gates are approved.
DATABASE_MIGRATION_URL=postgresql://admission_migrator:SET_IN_COOLIFY@postgres.internal.invalid:5432/admission_production
DATABASE_APP_URL=postgresql://admission_app:SET_IN_COOLIFY@postgres.internal.invalid:5432/admission_production

ADMISSION_DOCUMENTS_ENABLED=false
ADMISSION_WEB_ORIGIN=https://admission.example.invalid
ADMISSION_APP_ORIGIN=https://admission.example.invalid
ADMISSION_PUBLIC_WEB_URL=https://admission.example.invalid
ADMISSION_API_PUBLIC_URL=https://admission-api.example.invalid
ADMISSION_TENANT_PUBLIC_ID=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
CSRF_SIGNING_SECRET=SET_IN_COOLIFY_SECRET_STORE_MINIMUM_32_BYTES

DOCUMENT_UPLOAD_HARD_MAX_BYTES=10485760
DOCUMENT_WORKER_POLL_MS=1000
DOCUMENT_JOB_MAX_ATTEMPTS=5
DOCUMENT_JOB_BASE_BACKOFF_MS=1000
S3_ACCESS_KEY_ID=SET_IN_COOLIFY_SECRET_STORE_IF_DOCUMENTS_ENABLED
S3_SECRET_ACCESS_KEY=SET_IN_COOLIFY_SECRET_STORE_IF_DOCUMENTS_ENABLED
S3_ENDPOINT=https://storage.example.invalid
S3_REGION=auto
S3_APPROVED_BUCKET=admission-production-approved
S3_QUARANTINE_BUCKET=admission-production-quarantine
S3_ALLOW_INSECURE_INTERNAL=false
S3_INSECURE_ALLOWED_HOST=
CLAMAV_HOST=clamav.internal.invalid
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

OUTBOX_LEASE_MS=60000

# Synthetic is the only permitted default for the first production candidate.
EMAIL_DELIVERY_MODE=synthetic
REAL_EMAIL_DELIVERY_AUTHORIZED=false
RESEND_API_KEY=SET_IN_COOLIFY_SECRET_STORE
RESEND_FROM_EMAIL=Admission Synthetic <synthetic@notifications.example.invalid>
RESEND_WEBHOOK_SECRET=SET_IN_COOLIFY_SECRET_STORE
EMAIL_SUPPRESSION_HMAC_SECRET=SET_IN_COOLIFY_SECRET_STORE_MINIMUM_32_BYTES
EMAIL_SUPPRESSION_HASH_KEY_VERSION=1
EMAIL_SUPPRESSION_PREVIOUS_KEYS_JSON=[]
RESEND_TIMEOUT_MS=10000

# Production tenant bootstrap is a separate, audited one-shot operation. Keep
# empty in the permanent environment and remove temporary values immediately.
TENANT_BOOTSTRAP_CODE=
TENANT_BOOTSTRAP_NAME=
TENANT_BOOTSTRAP_ADMIN_EMAIL=
TENANT_BOOTSTRAP_CONFIRM=
