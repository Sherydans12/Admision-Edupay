# Contract only. Copy variable names into Coolify; never commit real values.
# Initial core preproduction excludes document flows. S3/R2 and ClamAV are
# production-readiness dependencies and must not be configured in this environment.
DATABASE_MIGRATION_URL=postgresql://admission_migrator:SET_IN_COOLIFY@postgres.internal.invalid:5432/admission_preprod
DATABASE_APP_URL=postgresql://admission_app:SET_IN_COOLIFY@postgres.internal.invalid:5432/admission_preprod

ADMISSION_DOCUMENTS_ENABLED=false
ADMISSION_WEB_ORIGIN=https://preprod.admision.example.invalid
ADMISSION_APP_ORIGIN=https://preprod.admision.example.invalid
ADMISSION_PUBLIC_WEB_URL=https://preprod.admision.example.invalid
ADMISSION_API_PUBLIC_URL=https://api.preprod.admision.example.invalid
ADMISSION_TENANT_PUBLIC_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
CSRF_SIGNING_SECRET=SET_IN_COOLIFY_SECRET_STORE_MINIMUM_32_BYTES

OUTBOX_LEASE_MS=60000

EMAIL_DELIVERY_MODE=synthetic
REAL_EMAIL_DELIVERY_AUTHORIZED=false
RESEND_API_KEY=SET_IN_COOLIFY_SECRET_STORE
RESEND_FROM_EMAIL=Admission Synthetic <synthetic@notifications.example.invalid>
RESEND_WEBHOOK_SECRET=SET_IN_COOLIFY_SECRET_STORE
EMAIL_SUPPRESSION_HMAC_SECRET=SET_IN_COOLIFY_SECRET_STORE_MINIMUM_32_BYTES
EMAIL_SUPPRESSION_HASH_KEY_VERSION=1
EMAIL_SUPPRESSION_PREVIOUS_KEYS_JSON=[]
RESEND_TIMEOUT_MS=10000

# One-shot synthetic authority reviewer provisioning only. Keep these empty in
# the permanent environment; provide them temporarily at invocation time and
# remove them immediately after the operation completes.
# PREPROD_SYNTHETIC=true
# SYNTHETIC_REVIEWER_TENANT_CODE=synthetic-school
# SYNTHETIC_REVIEWER_EMAIL=authority-reviewer@resend.dev
# SYNTHETIC_REVIEWER_CONFIRM=synthetic-school

# One-shot synthetic admissions operator provisioning. Keep these empty in the
# permanent environment; provide them only for the explicit bootstrap command.
# PREPROD_SYNTHETIC=true
# SYNTHETIC_OPERATOR_TENANT_CODE=synthetic-school
# SYNTHETIC_OPERATOR_EMAIL=admissions-operator@resend.dev
# SYNTHETIC_OPERATOR_CONFIRM=synthetic-school
