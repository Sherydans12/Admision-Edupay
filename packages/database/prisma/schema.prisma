  ADULT_STUDENT_SELF
}

enum ApplicationAuthorityRelationship {
  MOTHER
  FATHER
  OTHER_RELATIVE
  OTHER
  SELF
}

enum ApplicationAuthorityBasis {
  PARENT
  LEGAL_REPRESENTATIVE
  PERSONAL_CARE_HOLDER
  AUTHORIZED_BY_AUTHORITY_HOLDER
  SELF
}

enum ApplicationAuthorityStatus {
  NOT_DECLARED
  DECLARED
  EVIDENCE_PENDING
  UNDER_REVIEW
  VERIFIED
  DISPUTED
  REJECTED
}

/// Semantic processing category separate from technical sensitivity (R4-001).
enum ProcessingCategory {
  ORDINARY_ADMISSION
  SUPPORT_ACCOMMODATION
  PIE_NEE_DIAGNOSTIC
  HEALTH
}

/// Institutional document classification distinct from health/PIE (R4-010).
enum DocumentClassification {
