  correctionDueAt      DateTime?             @map("correction_due_at") @db.Timestamptz(3)
  actorId              String                @map("actor_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission           DocumentSubmission    @relation(fields: [tenantId, documentSubmissionId], references: [tenantId, id], onDelete: Restrict)
  documentVersion      DocumentVersion?      @relation(fields: [tenantId, documentSubmissionId, documentVersionId], references: [tenantId, documentSubmissionId, id], onDelete: Restrict, map: "document_reviews_version_fkey")

  @@unique([tenantId, id])
  @@index([tenantId, documentSubmissionId, createdAt])
  @@map("document_reviews")
}

/// Narrow operational evidence for assisted application work; never a family impersonation session.
model AssistanceSession {
  id                      String                        @id @default(uuid()) @db.Uuid
  tenantId                String                        @map("tenant_id") @db.Uuid
  operatorUserId          String                        @map("operator_user_id") @db.Uuid
  operatorRoleSnapshot    String                        @map("operator_role_snapshot") @db.VarChar(120)
  familyProfileId         String                        @map("family_profile_id") @db.Uuid
  adultResponsibleUserId  String                        @map("adult_responsible_user_id") @db.Uuid
  adultPresentConfirmed   Boolean                       @map("adult_present_confirmed")
  authorizationConfirmed  Boolean                       @map("authorization_confirmed")
  authorizationMethod     AssistanceAuthorizationMethod @map("authorization_method")
  authorizationRecordedAt DateTime?                     @map("authorization_recorded_at") @db.Timestamptz(3)
  startedAt               DateTime                      @map("started_at") @db.Timestamptz(3)
  endedAt                 DateTime?                     @map("ended_at") @db.Timestamptz(3)
  status                  AssistanceSessionStatus       @default(ACTIVE)
  correlationId           String                        @map("correlation_id") @db.VarChar(120)
  createdAt               DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant                  Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  familyProfile           FamilyProfile                 @relation(fields: [familyProfileId], references: [id], onDelete: Restrict)
  application             Application?                  @relation("ApplicationAssistance")

  @@unique([tenantId, id])
  @@index([tenantId, operatorUserId, status])
  @@map("assistance_sessions")
}

/// Stable tenant-owned identity for an admission form; not a general CMS.
model FormDefinition {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  name      String        @db.VarChar(160)
  purpose   String        @db.VarChar(120)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions  FormVersion[]

  @@unique([tenantId, id])
  @@index([tenantId, purpose, name])
  @@map("form_definitions")
}

/// Versioned immutable-after-publication form configuration.
model FormVersion {
  id                            String                       @id @default(uuid()) @db.Uuid
  tenantId                      String                       @map("tenant_id") @db.Uuid
  formDefinitionId              String                       @map("form_definition_id") @db.Uuid
  versionNumber                 Int                          @map("version_number")
  lifecycle                     FormVersionLifecycle         @default(DRAFT)
  createdAt                     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt                   DateTime?                    @map("published_at") @db.Timestamptz(3)
  archivedAt                    DateTime?                    @map("archived_at") @db.Timestamptz(3)
  tenant                        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition                    FormDefinition               @relation(fields: [tenantId, formDefinitionId], references: [tenantId, id], onDelete: Restrict)
  sections                      FormSection[]
  fields                        FormField[]
  offerings                     AdmissionOffering[]
  applications                  Application[]
  draftAnswers                  ApplicationDraftAnswer[]
  snapshots                     ApplicationSnapshot[]
  documentRequirementConditions DocumentRequirementVersion[] @relation("DocumentRequirementConditionForm")

  @@unique([tenantId, id])
  @@unique([tenantId, formDefinitionId, versionNumber])
  @@index([tenantId, formDefinitionId, lifecycle])
  @@map("form_versions")
}

model FormSection {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  formVersionId String      @map("form_version_id") @db.Uuid
  title         String      @db.VarChar(160)
  description   String?     @db.VarChar(500)
  order         Int
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formVersion   FormVersion @relation(fields: [tenantId, formVersionId], references: [tenantId, id], onDelete: Restrict)
  fields        FormField[]

  @@unique([tenantId, formVersionId, id])
  @@unique([tenantId, formVersionId, order])
  @@index([tenantId, formVersionId])
  @@map("form_sections")
}

model FormField {
  id                            String                       @id @default(uuid()) @db.Uuid
  tenantId                      String                       @map("tenant_id") @db.Uuid
  formVersionId                 String                       @map("form_version_id") @db.Uuid
  sectionId                     String                       @map("section_id") @db.Uuid
  key                           String                       @db.VarChar(80)
  label                         String                       @db.VarChar(200)
  helpText                      String?                      @map("help_text") @db.VarChar(500)
  type                          FormFieldType
  required                      Boolean                      @default(false)
  sensitivity                   String                       @db.VarChar(40)
  processingCategory            ProcessingCategory?          @map("processing_category")
  purpose                       String                       @db.VarChar(160)
  order                         Int
  options                       Json?
  validationConfig              Json?                        @map("validation_config")
  conditionOperator             FormConditionOperator?       @map("condition_operator")
  conditionFieldId              String?                      @map("condition_field_id") @db.Uuid
  conditionValue                Json?                        @map("condition_value")
  createdAt                     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formVersion                   FormVersion                  @relation(fields: [tenantId, formVersionId], references: [tenantId, id], onDelete: Restrict)
  section                       FormSection                  @relation(fields: [tenantId, formVersionId, sectionId], references: [tenantId, formVersionId, id], onDelete: Restrict)
  conditionField                FormField?                   @relation("FormFieldCondition", fields: [tenantId, formVersionId, conditionFieldId], references: [tenantId, formVersionId, id], onDelete: Restrict)
  conditionDependents           FormField[]                  @relation("FormFieldCondition")
  draftAnswers                  ApplicationDraftAnswer[]
  documentRequirementConditions DocumentRequirementVersion[] @relation("DocumentRequirementConditionField")

  @@unique([tenantId, formVersionId, id])
  @@unique([tenantId, formVersionId, key])
  @@unique([tenantId, formVersionId, sectionId, order])
  @@index([tenantId, formVersionId, sectionId])
  @@map("form_fields")
}

model ApplicationDraftAnswer {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  formVersionId String      @map("form_version_id") @db.Uuid
  fieldId       String      @map("field_id") @db.Uuid
  value         Json
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [tenantId, applicationId, formVersionId], references: [tenantId, id, formVersionId], onDelete: Restrict)
  formVersion   FormVersion @relation(fields: [tenantId, formVersionId], references: [tenantId, id], onDelete: Restrict)
  field         FormField   @relation(fields: [tenantId, formVersionId, fieldId], references: [tenantId, formVersionId, id], onDelete: Restrict)

  @@unique([tenantId, applicationId, fieldId])
  @@index([tenantId, applicationId, formVersionId])
  @@map("application_draft_answers")
}

/// One immutable durable submission snapshot per application in E5-B.
model ApplicationSnapshot {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  applicationId String      @unique @map("application_id") @db.Uuid
  formVersionId String      @map("form_version_id") @db.Uuid
  schemaVersion Int         @default(1) @map("schema_version")
  payload       Json
  submittedBy   String      @map("submitted_by") @db.Uuid
  submittedAt   DateTime    @map("submitted_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [tenantId, applicationId, formVersionId], references: [tenantId, id, formVersionId], onDelete: Restrict)
  formVersion   FormVersion @relation(fields: [tenantId, formVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, applicationId, formVersionId])
  @@index([tenantId, applicationId])
  @@map("application_snapshots")
}

/// Tenant-owned append-only critical audit records; metadata is allowlisted by the application.
model AuditEvent {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String?         @map("tenant_id") @db.Uuid
  scope            AuditEventScope @default(TENANT)
  actorId          String          @map("actor_id") @db.Uuid
  effectiveActorId String          @map("effective_actor_id") @db.Uuid
  action           String          @db.VarChar(120)
  purpose          String          @db.VarChar(120)
  resourceType     String          @map("resource_type") @db.VarChar(120)
  resourceId       String?         @map("resource_id") @db.Uuid
  result           String          @db.VarChar(40)
  reasonCode       String?         @map("reason_code") @db.VarChar(80)
  correlationId    String          @map("correlation_id") @db.VarChar(120)
  metadata         Json?
  occurredAt       DateTime        @map("occurred_at") @db.Timestamptz(3)
  tenant           Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceType, resourceId])
  @@map("audit_events")
}

/// Communication record. Prepared on events/decisions, sent after human confirmation.
model Communication {
  id                         String                    @id @default(uuid()) @db.Uuid
  tenantId                   String                    @map("tenant_id") @db.Uuid
  applicationId              String                    @map("application_id") @db.Uuid
  purpose                    CommunicationPurpose
  audience                   CommunicationAudience     @default(FAMILY)
  templateKey                String                    @map("template_key") @db.VarChar(120)
  templateVersion            Int                       @map("template_version")
  lifecycle                  CommunicationLifecycle    @default(PREPARED)
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  preparedAt                 DateTime                  @default(now()) @map("prepared_at") @db.Timestamptz(3)
  confirmedAt                DateTime?                 @map("confirmed_at") @db.Timestamptz(3)
  confirmedBy                String?                   @map("confirmed_by") @db.Uuid
  recipientEmail             String                    @map("recipient_email") @db.VarChar(320)
  subject                    String                    @db.VarChar(240)
  body                       String                    @db.VarChar(4000)
  payloadSnapshot            Json                      @map("payload_snapshot")
  directionDecisionVersionId String?                   @map("direction_decision_version_id") @db.Uuid
  offerVersionId             String?                   @map("offer_version_id") @db.Uuid
  documentSubmissionId       String?                   @map("document_submission_id") @db.Uuid
  activityAppointmentId      String?                   @map("activity_appointment_id") @db.Uuid
  versionNumber              Int                       @default(1) @map("version_number")
  tenant                     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application                Application               @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)
  directionDecisionVersion   DirectionDecisionVersion? @relation(fields: [tenantId, applicationId, directionDecisionVersionId], references: [tenantId, applicationId, id], onDelete: Restrict)
  offerVersion               AdmissionOfferVersion?    @relation(fields: [tenantId, offerVersionId], references: [tenantId, id], onDelete: Restrict)
  documentSubmission         DocumentSubmission?       @relation(fields: [tenantId, documentSubmissionId], references: [tenantId, id], onDelete: Restrict)
  activityAppointment        ActivityAppointment?      @relation(fields: [tenantId, activityAppointmentId], references: [tenantId, id], onDelete: Restrict)
  attempts                   CommunicationAttempt[]
  operationalTasks           OperationalTask[]

  @@unique([tenantId, id])
  @@unique([tenantId, applicationId, id], map: "communications_application_id_key")
  @@index([tenantId, applicationId, purpose, lifecycle])
  @@map("communications")
}

/// Append-only communication delivery attempts.
model CommunicationAttempt {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @map("tenant_id") @db.Uuid
  communicationId    String                     @map("communication_id") @db.Uuid
  sequence           Int
  provider           String                     @db.VarChar(80)
  technicalStatus    CommunicationAttemptStatus @map("technical_status")
  providerReference  String?                    @map("provider_reference") @db.VarChar(160)
  attemptedAt        DateTime                   @map("attempted_at") @db.Timestamptz(3)
  completedAt        DateTime?                  @map("completed_at") @db.Timestamptz(3)
  sanitizedErrorCode String?                    @map("sanitized_error_code") @db.VarChar(120)
  deliveryEvidence   Json?                      @map("delivery_evidence")
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  communication      Communication              @relation(fields: [tenantId, communicationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, communicationId, sequence])
  @@index([tenantId, communicationId, attemptedAt])
  @@map("communication_attempts")
}

/// Internal operational task created when email delivery fails.
model OperationalTask {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  applicationId   String                @map("application_id") @db.Uuid
  communicationId String?               @map("communication_id") @db.Uuid
  type            OperationalTaskType
  status          OperationalTaskStatus @default(PENDING)
  title           String                @db.VarChar(240)
  description     String                @db.VarChar(1000)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt      DateTime?             @map("resolved_at") @db.Timestamptz(3)
  resolvedBy      String?               @map("resolved_by") @db.Uuid
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application     Application           @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)
  communication   Communication?        @relation(fields: [tenantId, communicationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, communicationId, type], map: "operational_tasks_comm_type_key")
  @@index([tenantId, status, createdAt])
  @@map("operational_tasks")
}

/// Manual contact log for telephone or direct operational interactions.
model ManualContact {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  actorId       String      @map("actor_id") @db.Uuid
  purpose       String      @db.VarChar(120)
  contactedAt   DateTime    @map("contacted_at") @db.Timestamptz(3)
  outcome       String      @db.VarChar(120)
  notes         String?     @db.VarChar(1000)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, applicationId, contactedAt])
  @@map("manual_contacts")
}

/// Tenant-scoped policy controlling which sensitive processing categories are
/// enabled. Absence of a row means disabled for HEALTH/PIE (fail-closed, R4-003/004).
/// ORDINARY_ADMISSION and SUPPORT_ACCOMMODATION are implicitly always enabled.
model SensitiveProcessingPolicy {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  category    ProcessingCategory
  enabled     Boolean            @default(false)
  purpose     String?            @db.VarChar(200)
  activatedBy String?            @map("activated_by") @db.Uuid
  activatedAt DateTime?          @map("activated_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activator   PlatformUser?      @relation("SensitiveProcessingPolicyActivator", fields: [activatedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, category])
  @@map("sensitive_processing_policies")
}

/// Tenant-scoped institutional business calendar configuration (R3-001, R3-002).
model TenantBusinessCalendar {
  id                 String                         @id @default(uuid()) @db.Uuid
  tenantId           String                         @unique @map("tenant_id") @db.Uuid
  timezone           String                         @db.VarChar(80)
  concurrencyVersion Int                            @default(1) @map("concurrency_version")
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "tenant_business_calendars_tenant_fkey")
  excludedDates      BusinessCalendarExcludedDate[]

  @@map("tenant_business_calendars")
}

/// Explicit tenant-configured excluded civil dates (holidays, closures) (R3-004).
model BusinessCalendarExcludedDate {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  calendarDate DateTime               @map("calendar_date") @db.Date
  reason       String                 @db.VarChar(200)
  createdBy    String                 @map("created_by") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "business_calendar_excluded_dates_tenant_fkey")
  calendar     TenantBusinessCalendar @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, map: "business_calendar_excluded_dates_calendar_fkey")
  creator      PlatformUser           @relation("BusinessCalendarExcludedDateCreator", fields: [createdBy], references: [id], onDelete: Restrict, map: "business_calendar_excluded_dates_creator_fkey")

  @@unique([tenantId, calendarDate])
  @@index([tenantId, calendarDate])
  @@map("business_calendar_excluded_dates")
}
