  PERSONALITY_DEVELOPMENT_REPORT
}

enum AdmissionRecommendationOption {
  RECOMENDAR_ADMISION
  NO_RECOMENDAR_ADMISION
  DEVOLVER_A_REVISION
}

enum RecommendationVersionLifecycle {
  DRAFT
  SUBMITTED
}

enum DirectionDisposition {
  APROBADO
  LISTA_DE_ESPERA
  RECHAZADO
  DEVUELTO_A_REVISION
}

enum SeatReservationState {
  ACTIVE
  COMMITTED
  RELEASED
}

enum WaitlistEntryState {
  ACTIVE
  PROMOTED
  WITHDRAWN
}

enum AdmissionOfferOrigin {
