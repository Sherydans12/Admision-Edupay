  ACCEPTED
  DECLINED
  EXPIRED
}

enum AdmissionOfferTerminalReason {
  FAMILY_ACCEPTED
  FAMILY_DECLINED
  DEADLINE_EXPIRED
  APPLICATION_WITHDRAWN
}

enum ActivityDefinitionKind {
