}

enum ApplicationActivityStatus {
  PENDIENTE
  PROGRAMADA
  REALIZADA
  REPROGRAMADA
  INASISTENCIA
  EXENTA
  NO_COMPLETADA
  CERRADA
}

enum ActivityAppointmentStatus {
  PROGRAMADA
  REALIZADA
  INASISTENCIA
  NO_COMPLETADA
  REPROGRAMADA
}

enum ActivityRescheduleRequestStatus {
  PENDING
  FULFILLED
}

enum ActivityAttemptOutcome {
  REALIZADA
  INASISTENCIA
  NO_COMPLETADA
}

enum ActivityResultValue {
  FAVORABLE
  NO_FAVORABLE
  INCONCLUSO
}

enum FormVersionLifecycle {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormFieldType {
  TEXT
  TEXTAREA
  SELECT
  RADIO
  BOOLEAN
  DATE
}

enum FormConditionOperator {
  EQUALS
  NOT_EQUALS
  IN
}

enum AuditEventScope {
  TENANT
