  ASSISTED
}

enum DocumentRequirementLifecycle {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentValidityRule {
  NONE
  LATEST_AVAILABLE
  MAX_AGE_DAYS
}

enum DocumentFunctionalStatus {
  PENDIENTE
  CARGADO
  EN_REVISION
  ACEPTADO
  OBSERVADO
  EXENTO
}

enum DocumentTechnicalStatus {
  UPLOAD_PENDING
  QUARANTINED
  PROCESSING
  READY_FOR_REVIEW
  BLOCKED_INVALID
  BLOCKED_INFECTED
  BLOCKED_UNSCANNABLE
  BLOCKED_SCAN_ERROR
  UPLOAD_FAILED
