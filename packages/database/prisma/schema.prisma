generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformUserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccountVerificationPurpose {
  ACCOUNT_REGISTRATION
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum RoleAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum OutboxMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum CampusStatus {
  ACTIVE
  ARCHIVED
}

enum AcademicYearStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AdmissionProcessStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AdmissionOfferingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AvailabilityCategory {
  POSTULATIONS_OPEN
  LIMITED_CAPACITY
  WAITLIST
  PROCESS_CLOSED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
}

