generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

/// Entidad exclusivamente sintética para la PoC E4-B de aislamiento tenant/RLS.
/// No representa un modelo funcional definitivo del producto.
model TenantProbeRecord {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("tenant_probe_records")
}
