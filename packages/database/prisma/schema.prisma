enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  UNSCANNABLE
  ERROR
}

enum DocumentOrigin {
  SELF_SERVICE
  ASSISTED
  PHYSICAL_DOCUMENT
}

enum DocumentReviewVerdict {
  ACCEPTED
  OBSERVED
  EXEMPTED
}

enum AssistanceSessionStatus {
  ACTIVE
  CLOSED
}

enum AssistanceAuthorizationMethod {
  IN_PERSON_CONFIRMED
}

enum CommunicationPurpose {
  ADMISSION_APPROVED
  ADMISSION_REJECTED
  WAITLIST_STATUS
  OFFER_AVAILABLE
  DOCUMENT_CORRECTION
  APPOINTMENT_SCHEDULED
  APPOINTMENT_RESCHEDULED
  OFFER_REMINDER
}

enum CommunicationAudience {
  FAMILY
  STAFF
}

enum CommunicationLifecycle {
  PREPARED
  CONFIRMED
  SENT
  DELIVERED
  FAILED
}

enum CommunicationAttemptStatus {
  SENT
  FAILED
  DELIVERED
}

enum OperationalTaskType {
  COMMUNICATION_FAILED
}

enum OperationalTaskStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

/// Identidad global de control-plane; no concede membresía ni autorización tenant.
model PlatformUser {
  id                         String                      @id @default(uuid()) @db.Uuid
  emailNormalized            String                      @unique @map("email_normalized") @db.VarChar(320)
  status                     PlatformUserStatus          @default(ACTIVE)
  emailVerifiedAt            DateTime?                   @map("email_verified_at") @db.Timestamptz(3)
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships                Membership[]
  sessions                   PlatformSession[]
  verificationChallenges    AccountVerificationChallenge[]
  supportElevations          SupportElevation[]
  familyProfile              FamilyProfile?
  applicationAuthorities     ApplicationAuthority[]
  activityRescheduleRequests ActivityRescheduleRequest[]
  activityAppointments       ActivityAppointment[]
  activatedSensitiveProcessingPolicies SensitiveProcessingPolicy[] @relation("SensitiveProcessingPolicyActivator")
  createdBusinessCalendarExcludedDates BusinessCalendarExcludedDate[] @relation("BusinessCalendarExcludedDateCreator")

  @@map("platform_users")
}

/// Global control-plane challenge; it is deliberately not tenant-owned or RLS-protected.
/// The raw challenge is delivered only through the identity email adapter.
model AccountVerificationChallenge {
  id                    String                       @id @default(uuid()) @db.Uuid
  platformUserId        String                       @map("platform_user_id") @db.Uuid
  normalizedChannelHash String                       @map("normalized_channel_hash") @db.Char(64)
  verifierHash          String                       @unique(map: "account_verification_challenges_verifier_hash_key") @map("verifier_hash") @db.Char(64)
  purpose               AccountVerificationPurpose   @default(ACCOUNT_REGISTRATION)
  expiresAt             DateTime                     @map("expires_at") @db.Timestamptz(3)
  consumedAt            DateTime?                    @map("consumed_at") @db.Timestamptz(3)
  supersededAt          DateTime?                    @map("superseded_at") @db.Timestamptz(3)
  attempts              Int                          @default(0)
  lastAttemptAt         DateTime?                    @map("last_attempt_at") @db.Timestamptz(3)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  platformUser          PlatformUser                 @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, createdAt])
  @@index([expiresAt])
  @@map("account_verification_challenges")
}

/// Sesión opaca server-side: sólo tokenHash persistido, nunca el token raw.
model PlatformSession {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  tokenHash            String       @unique @map("token_hash") @db.Char(64)
  issuedAt             DateTime     @map("issued_at") @db.Timestamptz(3)
  lastSeenAt           DateTime     @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt        DateTime     @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt    DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?    @map("revoked_at") @db.Timestamptz(3)
  rotatedFromSessionId String?      @unique(map: "platform_sessions_rotated_from_session_id_key") @map("rotated_from_session_id") @db.Uuid
  user                 PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([idleExpiresAt, absoluteExpiresAt])
  @@map("platform_sessions")
}

/// Tenant de aislamiento institucional; configuración funcional queda diferida.
model Tenant {
  id                              String                           @id @default(uuid()) @db.Uuid
  name                            String                           @db.VarChar(160)
  status                          TenantStatus                     @default(ACTIVE)
  createdAt                       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships                     Membership[]
  roleAssignments                 RoleAssignment[]
  supportElevations               SupportElevation[]
  outboxMessages                  OutboxMessage[]
  campuses                        Campus[]
  academicYears                   AcademicYear[]
  courseLevels                    CourseLevel[]
  admissionProcesses              AdmissionProcess[]
  admissionOfferings              AdmissionOffering[]
  applications                    Application[]
  applicationAuthorities          ApplicationAuthority[]
  applicationAuthorityReviews     ApplicationAuthorityReview[]
  applicationAuthorityEvidence    ApplicationAuthorityEvidence[]
  formDefinitions                 FormDefinition[]
  formVersions                    FormVersion[]
  formSections                    FormSection[]
  formFields                      FormField[]
  applicationAnswers              ApplicationDraftAnswer[]
  applicationSnapshots            ApplicationSnapshot[]
  documentRequirements            DocumentRequirement[]
  documentRequirementVersions     DocumentRequirementVersion[]
  documentSubmissions             DocumentSubmission[]
  documentVersions                DocumentVersion[]
  documentReviews                 DocumentReview[]
  assistanceSessions              AssistanceSession[]
  activityDefinitions             ActivityDefinition[]
  activityDefinitionVersions      ActivityDefinitionVersion[]
  applicationActivities           ApplicationActivity[]
  activityAppointments            ActivityAppointment[]
  activityRescheduleRequests      ActivityRescheduleRequest[]
  activityAttempts                ActivityAttempt[]
  activityResults                 ActivityResult[]
  admissionRecommendations        AdmissionRecommendation[]
  admissionRecommendationVersions AdmissionRecommendationVersion[]
  directionDecisions              DirectionDecision[]
  directionDecisionVersions       DirectionDecisionVersion[]
  admissionCapacities             AdmissionCapacity[]
  admissionCapacityAdjustments    AdmissionCapacityAdjustment[]
  seatReservations                SeatReservation[]
  waitlistEntries                 WaitlistEntry[]
  admissionOffers                 AdmissionOffer[]
  admissionOfferVersions          AdmissionOfferVersion[]
  offerAcceptances                OfferAcceptance[]
  integrationHandoffs              IntegrationHandoff[]
  applicationWithdrawals          ApplicationWithdrawal[]
  communications                  Communication[]
  communicationAttempts           CommunicationAttempt[]
  operationalTasks                OperationalTask[]
  manualContacts                  ManualContact[]
  auditEvents                     AuditEvent[]
  sensitiveProcessingPolicies     SensitiveProcessingPolicy[]
  businessCalendar                TenantBusinessCalendar?
  businessCalendarExcludedDates   BusinessCalendarExcludedDate[]

  @@map("tenants")
}

/// Membership tenant-owned; su consulta de resolución usa candidate + actor transaction-local.
model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  status          MembershipStatus @default(ACTIVE)
  startsAt        DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime?        @map("ends_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            PlatformUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]

  @@unique([tenantId, id])
  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("memberships")
}

/// Asignación explícita de rol y capacidades; no se infieren permisos desde roleKey.
model RoleAssignment {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  membershipId String               @map("membership_id") @db.Uuid
  roleKey      String               @map("role_key") @db.VarChar(80)
  permissions  String[]
  scopes       String[]
  status       RoleAssignmentStatus @default(ACTIVE)
  startsAt     DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime?            @map("ends_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership   Membership           @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, membershipId, status])
  @@map("role_assignments")
}

/// Elevación de soporte temporal, scoped y auditable; nunca permiso permanente de sesión.
model SupportElevation {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  actorUserId String       @map("actor_user_id") @db.Uuid
  reason      String       @db.VarChar(500)
  purpose     String       @db.VarChar(120)
  scopes      String[]
  categories  String[]
  startedAt   DateTime     @map("started_at") @db.Timestamptz(3)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  closedAt    DateTime?    @map("closed_at") @db.Timestamptz(3)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       PlatformUser @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, expiresAt, closedAt, revokedAt])
  @@index([actorUserId, startedAt])
  @@map("support_elevations")
}

/// Outbox técnico sin topics funcionales de admisión; tenant-owned y protegido por RLS.
model OutboxMessage {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  topic          String              @db.VarChar(120)
  payload        Json
  status         OutboxMessageStatus @default(PENDING)
  idempotencyKey String              @map("idempotency_key") @db.VarChar(160)
  availableAt    DateTime            @map("available_at") @db.Timestamptz(3)
  attempts       Int                 @default(0)
  claimedAt      DateTime?           @map("claimed_at") @db.Timestamptz(3)
  lastErrorCode  String?             @map("last_error_code") @db.VarChar(120)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, availableAt])
  @@map("outbox_messages")
}

/// Entidad exclusivamente sintética para la PoC E4-B de aislamiento tenant/RLS.
/// No representa un modelo funcional definitivo del producto.
model TenantProbeRecord {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("tenant_probe_records")
}

/// Global family profile. Tenant access is derived from the application and resource ownership.
model FamilyProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  displayName        String              @map("display_name") @db.VarChar(160)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               PlatformUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  students           Student[]
  applications       Application[]
  assistanceSessions AssistanceSession[]

  @@map("family_profiles")
}

/// Global family-owned student. No tenantId: the application establishes institutional context.
model Student {
  id              String        @id @default(uuid()) @db.Uuid
  familyProfileId String        @map("family_profile_id") @db.Uuid
  givenName       String        @map("given_name") @db.VarChar(120)
  familyName      String        @map("family_name") @db.VarChar(160)
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  familyProfile   FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  applications    Application[]

  @@index([familyProfileId, familyName, givenName])
  @@map("students")
}

/// Tenant-owned configurable campus.
model Campus {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  code      String              @db.VarChar(80)
  name      String              @db.VarChar(160)
  status    CampusStatus        @default(ACTIVE)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offerings AdmissionOffering[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("campuses")
}

/// Tenant-owned academic year configuration.
model AcademicYear {
  id                          String                       @id @default(uuid()) @db.Uuid
  tenantId                    String                       @map("tenant_id") @db.Uuid
  code                        String                       @db.VarChar(40)
  label                       String                       @db.VarChar(80)
  status                      AcademicYearStatus           @default(DRAFT)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processes                   AdmissionProcess[]
  offerings                   AdmissionOffering[]
  applications                Application[]
  documentRequirementVersions DocumentRequirementVersion[]
  activityDefinitionVersions  ActivityDefinitionVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("academic_years")
}

/// Tenant-owned course/level catalog item for an offering.
model CourseLevel {
  id                          String                       @id @default(uuid()) @db.Uuid
  tenantId                    String                       @map("tenant_id") @db.Uuid
  code                        String                       @db.VarChar(80)
  name                        String                       @db.VarChar(120)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offerings                   AdmissionOffering[]
  documentRequirementVersions DocumentRequirementVersion[]
  activityDefinitionVersions  ActivityDefinitionVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("course_levels")
}

/// Tenant-owned admission process. Only published processes can expose offerings.
model AdmissionProcess {
  id                          String                       @id @default(uuid()) @db.Uuid
  tenantId                    String                       @map("tenant_id") @db.Uuid
  academicYearId              String                       @map("academic_year_id") @db.Uuid
  code                        String                       @db.VarChar(80)
  name                        String                       @db.VarChar(160)
  status                      AdmissionProcessStatus       @default(DRAFT)
  opensAt                     DateTime?                    @map("opens_at") @db.Timestamptz(3)
  closesAt                    DateTime?                    @map("closes_at") @db.Timestamptz(3)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear                AcademicYear                 @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  offerings                   AdmissionOffering[]
  applications                Application[]
  documentRequirementVersions DocumentRequirementVersion[]
  activityDefinitionVersions  ActivityDefinitionVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, academicYearId])
  @@unique([tenantId, academicYearId, code])
  @@index([tenantId, status, academicYearId])
  @@map("admission_processes")
}

/// Tenant-owned public offering. The family projection exposes category only, never counts.
model AdmissionOffering {
  id                          String                       @id @default(uuid()) @db.Uuid
  tenantId                    String                       @map("tenant_id") @db.Uuid
  campusId                    String                       @map("campus_id") @db.Uuid
  academicYearId              String                       @map("academic_year_id") @db.Uuid
  processId                   String                       @map("process_id") @db.Uuid
  courseLevelId               String                       @map("course_level_id") @db.Uuid
  code                        String                       @db.VarChar(80)
  title                       String                       @db.VarChar(160)
  status                      AdmissionOfferingStatus      @default(DRAFT)
  availabilityCategory        AvailabilityCategory         @map("availability_category")
  formVersionId               String?                      @map("form_version_id") @db.Uuid
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus                      Campus                       @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict)
  academicYear                AcademicYear                 @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  process                     AdmissionProcess             @relation(fields: [tenantId, processId, academicYearId], references: [tenantId, id, academicYearId], onDelete: Restrict)
  courseLevel                 CourseLevel                  @relation(fields: [tenantId, courseLevelId], references: [tenantId, id], onDelete: Restrict)
  formVersion                 FormVersion?                 @relation(fields: [tenantId, formVersionId], references: [tenantId, id], onDelete: Restrict)
  applications                Application[]
  documentRequirementVersions DocumentRequirementVersion[]
  activityDefinitionVersions  ActivityDefinitionVersion[]
  admissionCapacity           AdmissionCapacity?
  seatReservations            SeatReservation[]
  waitlistEntries             WaitlistEntry[]
  admissionOffers             AdmissionOffer[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, processId, academicYearId])
  @@unique([tenantId, processId, courseLevelId, code])
  @@index([tenantId, status, availabilityCategory])
  @@map("admission_offerings")
}

/// Tenant-owned admission case. E5-E consumes the immutable submission.
model Application {
  id                              String                           @id @default(uuid()) @db.Uuid
  tenantId                        String                           @map("tenant_id") @db.Uuid
  familyProfileId                 String                           @map("family_profile_id") @db.Uuid
  studentId                       String                           @map("student_id") @db.Uuid
  academicYearId                  String                           @map("academic_year_id") @db.Uuid
  processId                       String                           @map("process_id") @db.Uuid
  offeringId                      String                           @map("offering_id") @db.Uuid
  formVersionId                   String?                          @map("form_version_id") @db.Uuid
  status                          ApplicationStatus                @default(DRAFT)
  draftData                       Json                             @map("draft_data")
  submittedAt                     DateTime?                        @map("submitted_at") @db.Timestamptz(3)
  origin                          ApplicationOrigin                @default(SELF_SERVICE)
  assistanceSessionId             String?                          @map("assistance_session_id") @db.Uuid
  documentRequirementsPinnedAt    DateTime?                        @map("document_requirements_pinned_at") @db.Timestamptz(3)
  activitiesPinnedAt              DateTime?                        @map("activities_pinned_at") @db.Timestamptz(3)
  createdAt                       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                          Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  familyProfile                   FamilyProfile                    @relation(fields: [familyProfileId], references: [id], onDelete: Restrict)
  student                         Student                          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear                    AcademicYear                     @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  process                         AdmissionProcess                 @relation(fields: [tenantId, processId], references: [tenantId, id], onDelete: Restrict)
  offering                        AdmissionOffering                @relation(fields: [tenantId, offeringId, processId, academicYearId], references: [tenantId, id, processId, academicYearId], onDelete: Restrict)
  formVersion                     FormVersion?                     @relation(fields: [tenantId, formVersionId], references: [tenantId, id], onDelete: Restrict)
  draftAnswers                    ApplicationDraftAnswer[]
  snapshot                        ApplicationSnapshot?
  documentSubmissions             DocumentSubmission[]
  activities                      ApplicationActivity[]
  assistanceSession               AssistanceSession?               @relation("ApplicationAssistance", fields: [tenantId, assistanceSessionId], references: [tenantId, id], onDelete: Restrict)
  admissionRecommendation         AdmissionRecommendation?
  admissionRecommendationVersions AdmissionRecommendationVersion[]
  directionDecision               DirectionDecision?
  directionDecisionVersions       DirectionDecisionVersion[]
  seatReservations                SeatReservation[]
  waitlistEntries                 WaitlistEntry[]
  admissionOffers                 AdmissionOffer[]
  offerAcceptances                OfferAcceptance[]
  authority                       ApplicationAuthority?
  authorityReviews                ApplicationAuthorityReview[]
  authorityEvidence               ApplicationAuthorityEvidence[]
  integrationHandoffs              IntegrationHandoff[]
  withdrawals                     ApplicationWithdrawal[]
  communications                  Communication[]
  operationalTasks                OperationalTask[]
  manualContacts                  ManualContact[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, formVersionId])
  @@unique([tenantId, id, offeringId])
  @@unique([tenantId, assistanceSessionId])
  @@index([tenantId, familyProfileId, status, updatedAt])
  @@index([tenantId, studentId, status])
  @@map("applications")
}

/// One stable authority root per tenant application. Absence is the only
/// operational representation of NOT_DECLARED before a family declaration.
model ApplicationAuthority {
  id                  String                           @id @default(uuid()) @db.Uuid
  tenantId            String                           @map("tenant_id") @db.Uuid
  applicationId       String                           @map("application_id") @db.Uuid
  authorityUserId     String                           @map("authority_user_id") @db.Uuid
  subjectMode         ApplicationAuthoritySubjectMode  @map("subject_mode")
  relationship        ApplicationAuthorityRelationship
  authorityBasis      ApplicationAuthorityBasis        @map("authority_basis")
  status              ApplicationAuthorityStatus       @default(DECLARED)
  dateOfBirthSnapshot DateTime                         @map("date_of_birth_snapshot") @db.Date
  declaredAt          DateTime                         @map("declared_at") @db.Timestamptz(3)
  verifiedAt          DateTime?                        @map("verified_at") @db.Timestamptz(3)
  disputedAt          DateTime?                        @map("disputed_at") @db.Timestamptz(3)
  rejectedAt          DateTime?                        @map("rejected_at") @db.Timestamptz(3)
  concurrencyVersion  Int                              @default(1) @map("concurrency_version")
  createdAt           DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application         Application                      @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)
  authorityUser       PlatformUser                     @relation(fields: [authorityUserId], references: [id], onDelete: Restrict)
  reviews             ApplicationAuthorityReview[]
  evidence            ApplicationAuthorityEvidence[]

  @@unique([tenantId, id, applicationId], map: "application_authorities_resource_key")
  @@unique([tenantId, applicationId])
  @@index([tenantId, status, applicationId])
  @@map("application_authorities")
}

/// Immutable lifecycle history. Root changes and this append are committed in
/// the same tenant transaction.
model ApplicationAuthorityReview {
  id              String                           @id @default(uuid()) @db.Uuid
  tenantId        String                           @map("tenant_id") @db.Uuid
  authorityId     String                           @map("authority_id") @db.Uuid
  applicationId   String                           @map("application_id") @db.Uuid
  sequenceNumber  Int                              @map("sequence_number")
  fromStatus      ApplicationAuthorityStatus       @map("from_status")
  toStatus        ApplicationAuthorityStatus       @map("to_status")
  subjectMode     ApplicationAuthoritySubjectMode  @map("subject_mode")
  relationship    ApplicationAuthorityRelationship
  authorityBasis  ApplicationAuthorityBasis        @map("authority_basis")
  actorUserId     String                           @map("actor_user_id") @db.Uuid
  reason          String?                          @db.VarChar(1000)
  evidenceManifest Json?                           @map("evidence_manifest")
  concurrencyVersion Int                            @map("concurrency_version")
  createdAt       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant          Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authority       ApplicationAuthority             @relation(fields: [tenantId, authorityId, applicationId], references: [tenantId, id, applicationId], onDelete: Restrict)
  application     Application                      @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, authorityId, sequenceNumber])
  @@index([tenantId, applicationId, createdAt])
  @@map("application_authority_reviews")
}

/// Narrow pointer to an already private, scanned DocumentVersion. No bytes,
/// object keys, or document type taxonomy are duplicated here.
model ApplicationAuthorityEvidence {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  authorityId       String               @map("authority_id") @db.Uuid
  applicationId     String               @map("application_id") @db.Uuid
  documentVersionId String               @map("document_version_id") @db.Uuid
  linkedByActorId   String               @map("linked_by_actor_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authority         ApplicationAuthority @relation(fields: [tenantId, authorityId, applicationId], references: [tenantId, id, applicationId], onDelete: Restrict)
  application       Application          @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)
  documentVersion   DocumentVersion      @relation(fields: [tenantId, documentVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, authorityId, documentVersionId])
  @@index([tenantId, applicationId, authorityId])
  @@map("application_authority_evidence")
}

/// Stable E5-E recommendation root: exactly one per application.
model AdmissionRecommendation {
  id               String                           @id @default(uuid()) @db.Uuid
  tenantId         String                           @map("tenant_id") @db.Uuid
  applicationId    String                           @map("application_id") @db.Uuid
  currentVersionId String?                          @map("current_version_id") @db.Uuid
  createdAt        DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application      Application                      @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)
  versions         AdmissionRecommendationVersion[] @relation("RecommendationVersions")

  @@unique([tenantId, id])
  @@unique([tenantId, applicationId])
  @@unique([tenantId, id, applicationId], map: "admission_recommendations_root_application_key")
  @@index([tenantId, applicationId, currentVersionId])
  @@map("admission_recommendations")
}

/// Immutable recommendation history. Only DRAFT may be edited before submit.
model AdmissionRecommendationVersion {
  id                 String                           @id @default(uuid()) @db.Uuid
  tenantId           String                           @map("tenant_id") @db.Uuid
  recommendationId   String                           @map("recommendation_id") @db.Uuid
  applicationId      String                           @map("application_id") @db.Uuid
  versionNumber      Int                              @map("version_number")
  previousVersionId  String?                          @map("previous_version_id") @db.Uuid
  option             AdmissionRecommendationOption
  foundation         String                           @db.VarChar(2000)
  lifecycle          RecommendationVersionLifecycle   @default(DRAFT)
  createdBy          String                           @map("created_by") @db.Uuid
  createdAt          DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  submittedBy        String?                          @map("submitted_by") @db.Uuid
  submittedAt        DateTime?                        @map("submitted_at") @db.Timestamptz(3)
  evidenceManifest   Json                             @map("evidence_manifest")
  tenant             Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recommendation     AdmissionRecommendation          @relation("RecommendationVersions", fields: [tenantId, recommendationId, applicationId], references: [tenantId, id, applicationId], onDelete: Restrict, map: "admission_recommendation_versions_recommendation_fkey")
  application        Application                      @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict, map: "admission_recommendation_versions_application_fkey")
  previousVersion    AdmissionRecommendationVersion?  @relation("RecommendationHistory", fields: [tenantId, recommendationId, previousVersionId], references: [tenantId, recommendationId, id], onDelete: Restrict, map: "admission_recommendation_versions_previous_same_root_fkey")
  nextVersions       AdmissionRecommendationVersion[] @relation("RecommendationHistory")
  directionDecisions DirectionDecisionVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, recommendationId, id], map: "admission_recommendation_versions_root_id_key")
  @@unique([tenantId, recommendationId, versionNumber])
  @@unique([tenantId, applicationId, id], map: "admission_recommendation_versions_application_id_key")
  @@index([tenantId, applicationId, lifecycle])
  @@map("admission_recommendation_versions")
}

/// Stable E5-E direction decision root: exactly one per application.
model DirectionDecision {
  id               String                     @id @default(uuid()) @db.Uuid
  tenantId         String                     @map("tenant_id") @db.Uuid
  applicationId    String                     @map("application_id") @db.Uuid
  currentVersionId String?                    @map("current_version_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application      Application                @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)
  versions         DirectionDecisionVersion[] @relation("DirectionDecisionVersions")

  @@unique([tenantId, id])
  @@unique([tenantId, applicationId])
  @@unique([tenantId, id, applicationId], map: "direction_decisions_root_application_key")
  @@index([tenantId, applicationId, currentVersionId])
  @@map("direction_decisions")
}

/// Immutable direction history. E5-F/E5-G consume its facts later.
model DirectionDecisionVersion {
  id                      String                         @id @default(uuid()) @db.Uuid
  tenantId                String                         @map("tenant_id") @db.Uuid
  directionDecisionId     String                         @map("direction_decision_id") @db.Uuid
  applicationId           String                         @map("application_id") @db.Uuid
  versionNumber           Int                            @map("version_number")
  previousVersionId       String?                        @map("previous_version_id") @db.Uuid
  recommendationVersionId String                         @map("recommendation_version_id") @db.Uuid
  disposition             DirectionDisposition
  foundation              String?                        @db.VarChar(2000)
  reason                  String?                        @db.VarChar(2000)
  decidedBy               String                         @map("decided_by") @db.Uuid
  decidedAt               DateTime                       @map("decided_at") @db.Timestamptz(3)
  evidenceManifest        Json                           @map("evidence_manifest")
  tenant                  Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decision                DirectionDecision              @relation("DirectionDecisionVersions", fields: [tenantId, directionDecisionId, applicationId], references: [tenantId, id, applicationId], onDelete: Restrict, map: "direction_decision_versions_decision_fkey")
  application             Application                    @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict, map: "direction_decision_versions_application_fkey")
  recommendationVersion   AdmissionRecommendationVersion @relation(fields: [tenantId, applicationId, recommendationVersionId], references: [tenantId, applicationId, id], onDelete: Restrict, map: "direction_decision_versions_recommendation_fkey")
  previousVersion         DirectionDecisionVersion?      @relation("DirectionDecisionHistory", fields: [tenantId, directionDecisionId, previousVersionId], references: [tenantId, directionDecisionId, id], onDelete: Restrict, map: "direction_decision_versions_previous_same_root_fkey")
  nextVersions            DirectionDecisionVersion[]     @relation("DirectionDecisionHistory")
  waitlistEntries         WaitlistEntry[]
  communications          Communication[]

  @@unique([tenantId, id])
  @@unique([tenantId, directionDecisionId, id], map: "direction_decision_versions_root_id_key")
  @@unique([tenantId, directionDecisionId, versionNumber])
  @@unique([tenantId, applicationId, id], map: "direction_decision_versions_application_id_key")
  @@index([tenantId, applicationId, recommendationVersionId])
  @@map("direction_decision_versions")
}

/// Admission-owned numeric capacity. Exact values are never projected to families.
model AdmissionCapacity {
  id                        String                        @id @default(uuid()) @db.Uuid
  tenantId                  String                        @map("tenant_id") @db.Uuid
  offeringId                String                        @map("offering_id") @db.Uuid
  configuredCapacity        Int                           @map("configured_capacity")
  offerValidityBusinessDays Int                           @default(3) @map("offer_validity_business_days")
  concurrencyVersion        Int                           @default(1) @map("concurrency_version")
  createdAt                 DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                    Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offering                  AdmissionOffering             @relation(fields: [tenantId, offeringId], references: [tenantId, id], onDelete: Restrict)
  adjustments               AdmissionCapacityAdjustment[]
  reservations              SeatReservation[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, offeringId], map: "admission_capacities_root_offering_key")
  @@unique([tenantId, offeringId])
  @@index([tenantId, offeringId, concurrencyVersion])
  @@map("admission_capacities")
}

/// Immutable history for every post-creation capacity change.
model AdmissionCapacityAdjustment {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  capacityId    String            @map("capacity_id") @db.Uuid
  offeringId    String            @map("offering_id") @db.Uuid
  previousValue Int               @map("previous_value")
  newValue      Int               @map("new_value")
  actorId       String            @map("actor_id") @db.Uuid
  reason        String            @db.VarChar(1000)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capacity      AdmissionCapacity @relation(fields: [tenantId, capacityId, offeringId], references: [tenantId, id, offeringId], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, capacityId, createdAt, id])
  @@map("admission_capacity_adjustments")
}

/// ACTIVE and COMMITTED consume capacity; RELEASED preserves history without consuming it.
model SeatReservation {
  id            String                  @id @default(uuid()) @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  capacityId    String                  @map("capacity_id") @db.Uuid
  applicationId String                  @map("application_id") @db.Uuid
  offeringId    String                  @map("offering_id") @db.Uuid
  state         SeatReservationState    @default(ACTIVE)
  reservedAt    DateTime                @map("reserved_at") @db.Timestamptz(3)
  committedAt   DateTime?               @map("committed_at") @db.Timestamptz(3)
  releasedAt    DateTime?               @map("released_at") @db.Timestamptz(3)
  releaseReason String?                 @map("release_reason") @db.VarChar(80)
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capacity      AdmissionCapacity       @relation(fields: [tenantId, capacityId, offeringId], references: [tenantId, id, offeringId], onDelete: Restrict)
  application   Application             @relation(fields: [tenantId, applicationId, offeringId], references: [tenantId, id, offeringId], onDelete: Restrict)
  offering      AdmissionOffering       @relation(fields: [tenantId, offeringId], references: [tenantId, id], onDelete: Restrict)
  offerVersions AdmissionOfferVersion[]
  acceptances   OfferAcceptance[]
  withdrawals   ApplicationWithdrawal[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, applicationId, offeringId], map: "seat_reservations_resource_key")
  @@index([tenantId, capacityId, state])
  @@map("seat_reservations")
}

/// Internal waitlist ordered by enteredAt plus id. No numeric rank is a family field.
model WaitlistEntry {
  id                         String                   @id @default(uuid()) @db.Uuid
  tenantId                   String                   @map("tenant_id") @db.Uuid
  applicationId              String                   @map("application_id") @db.Uuid
  offeringId                 String                   @map("offering_id") @db.Uuid
  directionDecisionVersionId String                   @map("direction_decision_version_id") @db.Uuid
  state                      WaitlistEntryState       @default(ACTIVE)
  concurrencyVersion         Int                      @default(1) @map("concurrency_version")
  enteredAt                  DateTime                 @map("entered_at") @db.Timestamptz(3)
  promotedAt                 DateTime?                @map("promoted_at") @db.Timestamptz(3)
  promotedBy                 String?                  @map("promoted_by") @db.Uuid
  withdrawnAt                DateTime?                @map("withdrawn_at") @db.Timestamptz(3)
  tenant                     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application                Application              @relation(fields: [tenantId, applicationId, offeringId], references: [tenantId, id, offeringId], onDelete: Restrict)
  offering                   AdmissionOffering        @relation(fields: [tenantId, offeringId], references: [tenantId, id], onDelete: Restrict)
  directionDecisionVersion   DirectionDecisionVersion @relation(fields: [tenantId, applicationId, directionDecisionVersionId], references: [tenantId, applicationId, id], onDelete: Restrict)
  withdrawals                ApplicationWithdrawal[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, applicationId, offeringId], map: "waitlist_entries_resource_key")
  @@index([tenantId, offeringId, state, enteredAt, id])
  @@map("waitlist_entries")
}

/// Stable offer root. Reopening creates a new window/version and reservation.
model AdmissionOffer {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  applicationId      String                  @map("application_id") @db.Uuid
  offeringId         String                  @map("offering_id") @db.Uuid
  origin             AdmissionOfferOrigin
  currentVersionId   String?                 @map("current_version_id") @db.Uuid
  concurrencyVersion Int                     @default(1) @map("concurrency_version")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application        Application             @relation(fields: [tenantId, applicationId, offeringId], references: [tenantId, id, offeringId], onDelete: Restrict)
  offering           AdmissionOffering       @relation(fields: [tenantId, offeringId], references: [tenantId, id], onDelete: Restrict)
  versions           AdmissionOfferVersion[] @relation("AdmissionOfferVersions")
  currentVersion     AdmissionOfferVersion?  @relation("AdmissionOfferCurrentVersion", fields: [tenantId, id, currentVersionId], references: [tenantId, offerId, id], onDelete: Restrict)
  acceptance         OfferAcceptance?
  withdrawals        ApplicationWithdrawal[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, applicationId, offeringId], map: "admission_offers_resource_key")
  @@unique([tenantId, applicationId])
  @@index([tenantId, offeringId, currentVersionId])
  @@map("admission_offers")
}

/// One exact offer window. Only ACTIVE may transition once to a terminal lifecycle.
model AdmissionOfferVersion {
  id                String                        @id @default(uuid()) @db.Uuid
  tenantId          String                        @map("tenant_id") @db.Uuid
  offerId           String                        @map("offer_id") @db.Uuid
  applicationId     String                        @map("application_id") @db.Uuid
  offeringId        String                        @map("offering_id") @db.Uuid
  reservationId     String                        @map("reservation_id") @db.Uuid
  versionNumber     Int                           @map("version_number")
  previousVersionId String?                       @map("previous_version_id") @db.Uuid
  origin            AdmissionOfferOrigin
  lifecycle         AdmissionOfferLifecycle       @default(ACTIVE)
  issuedAt          DateTime                      @map("issued_at") @db.Timestamptz(3)
  expiresAt         DateTime                      @map("expires_at") @db.Timestamptz(3)
  issuedBy          String                        @map("issued_by") @db.Uuid
  reopenReason      String?                       @map("reopen_reason") @db.VarChar(1000)
  terminalAt        DateTime?                     @map("terminal_at") @db.Timestamptz(3)
  terminalReason    AdmissionOfferTerminalReason? @map("terminal_reason")
  tenant            Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer             AdmissionOffer                @relation("AdmissionOfferVersions", fields: [tenantId, offerId, applicationId, offeringId], references: [tenantId, id, applicationId, offeringId], onDelete: Restrict)
  currentForOffers  AdmissionOffer[]              @relation("AdmissionOfferCurrentVersion")
  reservation       SeatReservation               @relation(fields: [tenantId, reservationId, applicationId, offeringId], references: [tenantId, id, applicationId, offeringId], onDelete: Restrict)
  previousVersion   AdmissionOfferVersion?        @relation("AdmissionOfferHistory", fields: [tenantId, offerId, previousVersionId], references: [tenantId, offerId, id], onDelete: Restrict)
  nextVersions      AdmissionOfferVersion[]       @relation("AdmissionOfferHistory")
  acceptances       OfferAcceptance[]
  withdrawals       ApplicationWithdrawal[]
  communications    Communication[]

  @@unique([tenantId, id])
  @@unique([tenantId, offerId, id], map: "admission_offer_versions_root_id_key")
  @@unique([tenantId, offerId, id, applicationId], map: "admission_offer_versions_application_id_key")
  @@unique([tenantId, offerId, id, applicationId, reservationId, offeringId], map: "admission_offer_versions_acceptance_resource_key")
  @@unique([tenantId, offerId, versionNumber])
  @@unique([tenantId, reservationId])
  @@index([tenantId, lifecycle, expiresAt, id])
  @@map("admission_offer_versions")
}

/// Immutable, explicit acceptance tied to one exact offer window.
model OfferAcceptance {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  offerId        String                @map("offer_id") @db.Uuid
  offerVersionId String                @map("offer_version_id") @db.Uuid
  applicationId  String                @map("application_id") @db.Uuid
  reservationId  String                @map("reservation_id") @db.Uuid
  offeringId     String                @map("offering_id") @db.Uuid
  actorId        String                @map("actor_id") @db.Uuid
  acceptedAt     DateTime              @map("accepted_at") @db.Timestamptz(3)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer          AdmissionOffer        @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Restrict)
  offerVersion   AdmissionOfferVersion @relation(fields: [tenantId, offerId, offerVersionId, applicationId, reservationId, offeringId], references: [tenantId, offerId, id, applicationId, reservationId, offeringId], onDelete: Restrict)
  application    Application           @relation(fields: [tenantId, applicationId, offeringId], references: [tenantId, id, offeringId], onDelete: Restrict)
  reservation    SeatReservation       @relation(fields: [tenantId, reservationId, applicationId, offeringId], references: [tenantId, id, applicationId, offeringId], onDelete: Restrict)
  integrationHandoff IntegrationHandoff?

  @@unique([tenantId, id])
